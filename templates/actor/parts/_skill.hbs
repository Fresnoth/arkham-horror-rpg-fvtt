<div class="skill-row">
    <label class="skill clickable" data-action="clickSkill" data-skill-key="{{skillKey}}">{{localize (concat "ARKHAM_HORROR.SKILL." skillKey)}}</label>
    <input type="number" name="system.skills.{{skillKey}}.current" value="{{skillData.current}}" data-dtype="Number" title="{{localize "ARKHAM_HORROR.LABELS.Limit"}}" class="fancy-input skill-circle">
    <span class="skill-reaction-icon clickable" data-action="clickSkillReaction" data-skill-key="{{skillKey}}" title="{{localize "ARKHAM_HORROR.Chat.RollResult.ReactionRollTooltip"}}">
        <i class="fa-solid fa-arrow-rotate-left"></i>
    </span>
</div>
