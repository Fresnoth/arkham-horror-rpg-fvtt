<section class="tab {{tabs.effects.id}} {{tabs.effects.cssClass}} scrollable" id="effects"
    data-tab="{{tabs.effects.id}}" data-group="{{tabs.effects.group}}">
    {{#each effects as |section|}}
    <fieldset class="effects-section">
        <legend>{{section.label}}
            <a class='item-control item-create' data-action="effectCreate" data-effect-type='{{section.type}}'
                title='{{localize "DOCUMENT.Create" type=(localize "DOCUMENT.ActiveEffect")}}'
                aria-label='{{localize "DOCUMENT.Create" type=(localize "DOCUMENT.ActiveEffect")}}'>
                <i class='fas fa-plus'></i>
            </a>
        </legend>
        <ol class='items-list effects-list'>
            <li class='item flexrow items-header'>
                <div class='item-name'>{{localize "ARKHAM_HORROR.PROPS.Name"}}</div>
                <div class='item-prop effect-source'>{{localize "ARKHAM_HORROR.Effect.Source"}}</div>
                <div class='item-prop effect-duration'>{{localize "ARKHAM_HORROR.Effect.Duration"}}</div>
                <div class='item-controls'></div>
            </li>
            {{#each section.effects as |effect|}}
            <li class='item flexrow effect{{#if effect.fromItem}} effect-from-item{{/if}}' data-effect-id='{{effect.id}}'
                data-effect-uuid='{{effect.uuid}}'>
                <div class='item-name'>
                    <div class='item-image'>
                        <img src='{{effect.img}}' title='{{effect.name}}' width='24' height='24' />
                    </div>
                    <span>{{effect.name}}</span>
                </div>
                <div class='item-prop effect-source'>
                    {{#if effect.fromItem}}
                    <i class='fa-solid fa-link effect-source-icon'
                        data-tooltip='{{localize "ARKHAM_HORROR.Effect.FromItem" itemName=effect.itemName}}'></i>
                    {{/if}}
                    <span>{{effect.sourceName}}</span>
                </div>
                <div class='item-prop effect-duration'>{{effect.duration.label}}</div>
                <div class='item-controls'>
                    <a class='item-control' data-action="effectToggle"
                        title='{{localize "ARKHAM_HORROR.Effect.Toggle"}}'
                        aria-label='{{localize "ARKHAM_HORROR.Effect.Toggle"}}'>
                        <i class='fa-solid {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}'></i>
                    </a>
                    <a class='item-control item-edit' data-action="effectEdit"
                        title='{{localize "DOCUMENT.Update" type=(localize "DOCUMENT.ActiveEffect")}}'
                        aria-label='{{localize "DOCUMENT.Update" type=(localize "DOCUMENT.ActiveEffect")}}'>
                        <i class='fas fa-edit'></i>
                    </a>
                    {{#if effect.fromItem}}
                    {{!-- The effect belongs to the item; it has to be deleted there. --}}
                    <span class='item-control item-control-locked'
                        data-tooltip='{{localize "ARKHAM_HORROR.Effect.Errors.DeleteOnItem" itemName=effect.itemName}}'>
                        <i class='fas fa-lock'></i>
                    </span>
                    {{else}}
                    <a class='item-control item-delete' data-action="effectDelete"
                        title='{{localize "DOCUMENT.Delete" type=(localize "DOCUMENT.ActiveEffect")}}'
                        aria-label='{{localize "DOCUMENT.Delete" type=(localize "DOCUMENT.ActiveEffect")}}'>
                        <i class='fas fa-trash'></i>
                    </a>
                    {{/if}}
                </div>
            </li>
            {{else}}
            <li class='item effects-empty'>{{localize "ARKHAM_HORROR.Effect.None"}}</li>
            {{/each}}
        </ol>
    </fieldset>
    {{/each}}
</section>
