<section class="tab {{tabs.form.id}} {{tabs.form.cssClass}} scrollable" id="form" data-tab="{{tabs.form.id}}"
    data-group="{{tabs.form.group}}">
    <div class="resource-group-styled roll-effects-sheet">
        <div class="form-group">
            <label for="has-special-rules">{{localize "ARKHAM_HORROR.PROPS.HasSpecialRules"}}</label>
            <input type="checkbox" id="has-special-rules" name="system.hasSpecialRules" {{#if system.hasSpecialRules}}checked{{/if}} />
        </div>
        <div class="form-group">
            <label for="weight">{{localize "ITEM.UsefulItem.weight"}}</label>
            <input type="number" id="weight" name="system.weight" value="{{system.weight}}" min="0" />
        </div>
        <div class="form-group">
            <label for="cost">{{localize "ITEM.Weapon.cost"}}</label>
            <input type="number" id="cost" name="system.cost" value="{{system.cost}}" min="0" step="0.01" inputmode="decimal" />
        </div>

        <hr />

        {{> "systems/arkham-horror-rpg-fvtt/templates/item/parts/usage.hbs"}}

        <hr />

        {{> "systems/arkham-horror-rpg-fvtt/templates/item/parts/roll-effects.hbs"
            title=(localize "ARKHAM_HORROR.KNACK_SHEET.RollEffectsPromptSelectable")}}
    </div>
</section>